<view class="main-page">
  <!-- 顶部状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶栏：标题 + 日期 -->
  <view class="header">
    <view class="header-left">
      <text class="greeting">{{greeting}}</text>
      <text class="date">{{todayDate}}</text>
    </view>
    <view class="header-right">
      <text class="user-name">{{userName}}</text>
    </view>
  </view>

  <view class="river-entry" bindtap="goRiver" role="button" aria-label="打开时间长河">
    <view class="river-entry-text">
      <text class="river-entry-kicker">TIME RIVER · 体验版</text>
      <text class="river-entry-title">走进时间长河</text>
      <text class="river-entry-desc">在记忆的海洋里，偶遇一个瞬间</text>
    </view>
    <text class="river-entry-arrow">↗</text>
  </view>

</view>
