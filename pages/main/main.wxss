/* 模块首页 */
.main-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--bg);
}

/* 顶栏 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 16px 20px 12px;
  position: relative;
  z-index: 10;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.greeting {
  font-size: 22px;
  font-weight: 700;
  color: var(--text);
}

.date {
  font-size: 12px;
  color: var(--text-muted);
}

.header-right {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 14px;
  color: var(--accent);
  font-weight: 500;
}

.river-entry {
  margin: 4px 16px 14px;
  padding: 20px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(125deg, #10293e, #23585b);
  color: #f1f8f5;
  box-shadow: 0 10px 22px rgba(19, 49, 57, .15);
}
.river-entry-text { display: flex; flex-direction: column; gap: 5px; }
.river-entry-kicker { font-size: 10px; letter-spacing: 2px; color: #a3d6c8; }
.river-entry-title { font-size: 20px; font-weight: 700; }
.river-entry-desc { font-size: 12px; color: #c6dcd7; }
.river-entry-arrow { font-size: 24px; color: #b8e5d8; }
