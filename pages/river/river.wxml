<view class="river-page">
  <view class="sky-glow sky-glow-one"></view>
  <view class="sky-glow sky-glow-two"></view>
  <view class="river-content">
    <view class="intro">
      <text class="eyebrow">A WORLD OF YOUR DAYS</text>
      <text class="headline">时间长河</text>
      <text class="intro-text">生活里那些微小的瞬间，也值得再次遇见。</text>
      <text class="demo-badge">{{status}}</text>
    </view>

    <view class="ocean" aria-label="选择一个时刻">
      <view class="orbit orbit-outer"></view>
      <view class="orbit orbit-inner"></view>
      <view class="ocean-core"><text>时光</text><text class="core-small">在此流动</text></view>
      <button wx:for="{{stars}}" wx:key="id" class="memory-star star-{{index}} {{activeIndex === item.index ? 'star-active' : ''}}" data-index="{{item.index}}" bindtap="selectMemory" aria-label="{{item.date}} {{item.title}}">
        <text class="star-symbol">{{item.symbol}}</text>
      </button>
      <text class="ocean-hint">轻触光点，走进一个瞬间</text>
    </view>

    <view class="memory-card">
      <view class="card-meta"><text>{{selected.date}}</text><text>{{selected.category}}</text></view>
      <text class="card-title">{{selected.title}}</text>
      <text class="card-text">{{selected.text}}</text>
      <view class="card-footer"><text>{{selected.note}}</text><text>✦</text></view>
    </view>

    <button class="discover" bindtap="discover" disabled="{{discovering}}">{{discovering ? '正在寻找…' : '遇见另一个瞬间'}} <text>↗</text></button>
    <text wx:if="{{discoverError}}" class="load-error">{{discoverError}}</text>
    <view class="timeline-heading"><text>沿着时间走</text><text class="timeline-caption">{{countLabel}}</text></view>
    <picker mode="date" value="{{selectedDate}}" bindchange="chooseDate"><view class="timeline-caption">{{selectedDate ? '日期：' + selectedDate : '选择日期'}}</view></picker>
    <button wx:if="{{selectedDate}}" class="load-more" bindtap="clearDate">查看全部日期</button>
    <scroll-view class="timeline" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="timeline-row">
        <button wx:for="{{memories}}" wx:key="id" class="timeline-item {{activeIndex === index ? 'timeline-active' : ''}}" data-index="{{index}}" bindtap="selectMemory">
          <text class="timeline-dot">●</text><text class="timeline-date">{{item.date}}</text><text class="timeline-name">{{item.category}}</text>
        </button>
      </view>
    </scroll-view>
    <button wx:if="{{hasMore}}" class="load-more" bindtap="loadMore" disabled="{{loadingMore}}">{{loadingMore ? '正在寻找…' : '加载更早的回忆'}}</button>
    <text wx:if="{{loadMoreError}}" class="load-error">{{loadMoreError}}</text>
    <text class="demo-note">{{mode === 'demo' ? '以下内容为虚构示例，不会保存或上传。' : '回忆按时间排列，可继续加载更早的记录。'}}</text>
  </view>
</view>
