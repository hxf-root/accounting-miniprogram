<view class="settings-page">
  <!-- 顶部状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶栏 -->
  <view class="header">
    <text class="header-title">设置</text>
    <text class="header-subtitle">{{userName}}</text>
  </view>

  <scroll-view class="content-scroll" scroll-y show-scrollbar="{{false}}">
    <!-- ===== 数据导入导出 ===== -->
    <view class="section-title">数据管理</view>
    <view class="glass-card">
      <view wx:if="{{hasAccount}}" class="action-row" bindtap="onExport">
        <view class="action-left">
          <text class="action-icon">📤</text>
          <view class="action-text-wrap">
            <text class="action-label">导出数据</text>
            <text class="action-desc">导出账户中的数据，包含旧记录</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{!hasAccount}}" class="action-row" bindtap="connectAccount">
      <text class="action-label">连接已有账户以导出旧数据</text>
    </view>

    <view wx:if="{{hasAccount}}" class="section-title">微信连接</view>
    <view wx:if="{{hasAccount}}" class="glass-card">
      <view wx:if="{{wechatConfigured === true && wechatBound === false}}" class="action-row" bindtap="bindWechat">
        <view class="action-text-wrap"><text class="action-label">连接微信</text><text class="action-desc">连接后可尝试自动进入私人回忆</text></view>
        <text class="action-arrow">›</text>
      </view>
      <view wx:elif="{{wechatConfigured === true && wechatBound === true}}" class="action-row" bindtap="unbindWechat">
        <view class="action-text-wrap"><text class="action-label">解除微信连接</text><text class="action-desc">解除后关闭自动识别</text></view>
        <text class="action-arrow">›</text>
      </view>
      <view wx:else class="action-row">
        <view class="action-text-wrap"><text class="action-label">{{wechatBound === true ? '微信已连接' : '微信连接暂不可用'}}</text><text class="action-desc">{{wechatBound === true ? '连接服务暂不可用' : '连接状态暂无法确认，请稍后重试'}}</text></view>
      </view>
      <view wx:if="{{wechatBound === true && (wechatConfigured === true || autoEnabled)}}" class="action-row" bindtap="setAutoEnabled">
        <view class="action-text-wrap"><text class="action-label">本机自动识别：{{autoEnabled ? '已开启' : '已关闭'}}</text><text class="action-desc">点击切换，不影响微信绑定</text></view>
      </view>
    </view>

    <view wx:if="{{hasAccount}}" class="section-title">高驰同步</view>
    <view wx:if="{{hasAccount}}" class="glass-card">
      <view class="action-row">
        <view class="action-text-wrap">
          <text class="action-label">{{sourceStatus === 'active' ? '已允许同步' : sourceStatus === 'paused' ? '已暂停同步' : sourceStatus === 'unconfigured' ? '尚未配置同步' : '同步状态暂不可用'}}</text>
          <text class="action-desc">{{sourceLastSuccess ? '上次成功同步日期：' + sourceLastSuccess : '还没有可显示的成功同步日期'}}</text>
        </view>
      </view>
      <view wx:if="{{sourceStatus === 'active' || sourceStatus === 'paused'}}" class="action-row" bindtap="toggleCoros">
        <text class="action-label">{{sourceBusy ? '正在处理…' : sourceStatus === 'active' ? '暂停同步' : '恢复同步'}}</text>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <!-- ===== 应用信息 ===== -->
    <view class="section-title">关于</view>
    <view class="glass-card about-card">
      <view class="about-row">
        <text class="about-label">应用名称</text>
        <text class="about-value">抱布记</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-row">
        <text class="about-label">版本</text>
        <text class="about-value">1.0.0</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-row">
        <text class="about-label">用户</text>
        <text class="about-value">{{userName}}</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view wx:if="{{hasAccount}}" class="logout-wrap">
      <button class="btn-outline logout-btn" bindtap="onLogout">退出登录</button>
    </view>

    <!-- 底部安全区 -->
    <view class="bottom-safe"></view>
  </scroll-view>

  <view wx:if="{{showWechatBindModal}}" class="popup-mask" bindtap="cancelWechatBind">
    <view class="popup-content" catchtap="">
      <view class="modal-header"><text class="modal-title">确认账户</text></view>
      <view class="modal-body">
        <text class="modal-subtext">首次连接微信需要验证抱布记账户密码，之后无需每次输入。</text>
        <input class="setting-input" type="password" placeholder="请输入账户密码" value="{{wechatBindPassword}}" bindinput="onBindPasswordInput" />
      </view>
      <view class="modal-actions">
        <button class="btn-outline modal-btn" bindtap="cancelWechatBind" disabled="{{identityBusy}}">取消</button>
        <button class="btn-primary modal-btn" bindtap="confirmWechatBind" disabled="{{identityBusy}}">确认连接</button>
      </view>
    </view>
  </view>
</view>
