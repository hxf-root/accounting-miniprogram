<view class="settings-page">
  <!-- 顶部状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶栏 -->
  <view class="header">
    <text class="header-title">设置</text>
    <text class="header-subtitle">{{userName}}</text>
  </view>

  <scroll-view class="content-scroll" scroll-y show-scrollbar="{{false}}">
    <!-- ===== 数据导入导出 ===== -->
    <view class="section-title">数据管理</view>
    <view class="glass-card">
      <view wx:if="{{hasAccount}}" class="action-row" bindtap="onExport">
        <view class="action-left">
          <text class="action-icon">📤</text>
          <view class="action-text-wrap">
            <text class="action-label">导出数据</text>
            <text class="action-desc">导出账户中的数据，包含旧记录</text>
          </view>
        </view>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <view wx:if="{{!hasAccount}}" class="action-row" bindtap="connectAccount">
      <text class="action-label">连接已有账户以导出旧数据</text>
    </view>

    <view wx:if="{{hasAccount}}" class="section-title">微信连接</view>
    <view wx:if="{{hasAccount}}" class="glass-card">
      <view wx:if="{{!wechatEnabled}}" class="action-row" bindtap="bindWechat">
        <view class="action-text-wrap"><text class="action-label">连接微信</text><text class="action-desc">连接后可尝试自动进入私人回忆</text></view>
        <text class="action-arrow">›</text>
      </view>
      <view wx:else class="action-row" bindtap="unbindWechat">
        <view class="action-text-wrap"><text class="action-label">解除微信连接</text><text class="action-desc">解除后关闭自动识别</text></view>
        <text class="action-arrow">›</text>
      </view>
    </view>

    <!-- ===== 应用信息 ===== -->
    <view class="section-title">关于</view>
    <view class="glass-card about-card">
      <view class="about-row">
        <text class="about-label">应用名称</text>
        <text class="about-value">抱布记</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-row">
        <text class="about-label">版本</text>
        <text class="about-value">1.0.0</text>
      </view>
      <view class="about-divider"></view>
      <view class="about-row">
        <text class="about-label">用户</text>
        <text class="about-value">{{userName}}</text>
      </view>
    </view>

    <!-- 退出登录 -->
    <view wx:if="{{hasAccount}}" class="logout-wrap">
      <button class="btn-outline logout-btn" bindtap="onLogout">退出登录</button>
    </view>

    <!-- 底部安全区 -->
    <view class="bottom-safe"></view>
  </scroll-view>

</view>
